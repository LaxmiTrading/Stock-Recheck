#-----------------------------------------------------------------------------
# Copy to `.env` for local development. NEVER commit real values.
# In production set these in Netlify → Site configuration → Environment variables.
#-----------------------------------------------------------------------------

# --- Zoho Books (READ-ONLY integration) ---------------------------------
# Create a "Server-based Application" client at https://api-console.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Obtained once through the in-app OAuth flow (Settings → Zoho → Connect Zoho).
ZOHO_REFRESH_TOKEN=
# Accounts server for the data centre the Zoho account belongs to.
#   India: https://accounts.zoho.in   |  US: https://accounts.zoho.com
#   EU: https://accounts.zoho.eu      |  AU: https://accounts.zoho.com.au
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
# Returned by Zoho during the token exchange. Leave blank to auto-discover.
#   India: https://www.zohoapis.in
ZOHO_API_DOMAIN=
ZOHO_ORGANIZATION_ID=

# --- Application ------------------------------------------------------------
APP_BASE_URL=http://localhost:8888

# Comma-separated origins allowed to call this API with credentials, for when
# the UI is hosted separately (GitHub Pages) from the API (Netlify). Exact
# match, scheme included, NO trailing slash and no wildcards.
#   e.g. FRONTEND_ORIGINS=https://laxmitrading.github.io
#
# Leave EMPTY for a single-origin deployment. Setting it has a security cost:
# it switches the session cookie from SameSite=Lax to SameSite=None, so this
# list becomes the only thing preventing another site from making credentialed
# requests. Add nothing to it that you do not control.
FRONTEND_ORIGINS=
# 32+ random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=
# Session lifetime in seconds (default 43200 = 12h).
AUTH_SESSION_SECONDS=43200

# --- Database ---------------------------------------------------------------
# Netlify DB (Neon) injects NETLIFY_DATABASE_URL automatically in production.
# DATABASE_URL takes precedence when set, which lets you point at any Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_recheck

# --- Local mock mode (section 42) -------------------------------------------
# When "true" the Zoho client is replaced by an in-memory fixture set so the
# whole app can be exercised without Zoho credentials.
# MUST remain unset/false in production.
ZOHO_MOCK_MODE=false
